# Copy to server/api/.env for local development. In production these are set in Coolify (see coolify.md).

NODE_ENV=development
PORT=3000

# Origin of the web app. It must match what the browser shows EXACTLY (scheme + host, no trailing slash):
# it is the single allowed CORS origin and is used in email, gallery and Telegram links.
# Production: https://photodey.com
CLIENT_URL=http://localhost:5173
# Public URL of this API.   Production: https://api.photodey.com
SERVER_URL=http://localhost:3000

# Local values match docker-compose.yml. In production use the internal URLs from Coolify.
DATABASE_URL=postgresql://photodey:photodey123@localhost:5433/photodey_dev?schema=public
REDIS_URL=redis://:photodeyredis123@localhost:6379

# How many queue jobs one Node worker runs at once (1-20).
WORKER_CONCURRENCY=3

# Generate each secret with:  openssl rand -hex 32
ACCESS_TOKEN_SECRET=
# Must be identical in server/ai/.env
AI_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET=

GMAIL_USER=
GMAIL_APP_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=photodeybot

# Production only: which process a container runs (api | upload | email). Leave unset locally.
# PROCESS=api
